# ============================================================
# EXEMPLO de variáveis — copie para .env NO SERVIDOR e preencha.
# NUNCA commitar/subir o .env preenchido. Sem valores reais aqui.
# ============================================================

# ---- Shopee Affiliate Open API ----
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=
SHOPEE_API_ENDPOINT=https://open-api.affiliate.shopee.com.br/graphql

# ---- PostgreSQL ----
# Prefira as PARTES (o app monta a URL com percent-encoding, então senha com
# @ : / # $ % ou espaço funciona). Só a senha é obrigatória; o resto tem default.
POSTGRES_PASSWORD=
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432
# POSTGRES_USER=motor
# POSTGRES_DB=motor
# Alternativa: URL pronta (tem precedência). CUIDADO: se a senha tiver
# @ : / # $ % ou espaço, ela PRECISA vir percent-encoded aqui.
# DATABASE_URL=postgresql://motor:SENHA@postgres:5432/motor

# ---- Redis ----
REDIS_URL=redis://redis:6379

# ---- Evolution API (WhatsApp) — JÁ RODA NA SUA VPS: aponte para ela ----
EVOLUTION_API_URL=http://SEU-HOST-EVOLUTION:8080   # onde a Evolution já roda
EVOLUTION_API_KEY=                                 # a AUTHENTICATION_API_KEY dela
WA_POSTER_INSTANCE=poster                          # nome padrão do número que posta
WA_LISTENER_INSTANCE=Listener                      # nome do número que só escuta

PUBLIC_APP_URL=                                     # URL pública deste app (p/ o webhook do listener), ex.: https://api.SEU-DOMINIO
# Obs.: EVOLUTION_API_URL/KEY acima também podem ser configuradas pela aba Config do painel.

# ---- IA (copy) — pode configurar pela interface (aba Config) em vez daqui ----
OPENAI_API_KEY=
COPY_MODEL=gpt-5.4-mini

# ---- Cadência / anti-ban ----
# ATENÇÃO: a cadência NÃO é variável de ambiente — ela é POR CANAL (grupo), guardada
# nas colunas da tabela `channels` (db/schema.sql). Todo canal novo nasce com:
#   drip_min_sec=1200 (20min), drip_max_sec=1800 (30min),
#   jitter_min_sec=180 (3min), jitter_max_sec=300 (5min),
#   quiet_start=00:00, quiet_end=07:00, daily_cap=250
# Para mudar um grupo específico, edite a linha dele em `channels`. Para mudar o
# padrão de novos grupos, edite os DEFAULTs em db/schema.sql.

# ---- Senha do painel (OPCIONAL — hoje o painel fica ABERTO, por escolha do dono) ----
# Preencher os DOIS liga o login (HTTP Basic) no painel e nas rotas /api.
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# ---- Fura-fila (limiares configuráveis) ----
PRIORITY_MIN_DISCOUNT_PCT=60       # desconto REAL >= 60% dispara
PRIORITY_MIN_SAVINGS_BRL=500       # ou economia >= R$500
PRIORITY_INTERRUPT_WAIT=true       # true = interrompe a espera e posta em seguida
PRIORITY_MIN_GAP_SECONDS=180       # gap mínimo mesmo furando fila

# ---- Detecção de desconto falso ----
FAKE_DISCOUNT_MAX_PCT=95           # >= 95% = provável erro/golpe -> revisar

# ---- Captura (seu nicho) — edite a gosto; separado por vírgula ----
# Tecnologia/PC + casa/eletrodomésticos + comida/condimentos.
# Cuidado com palavra ambígua: "monitor" sozinho traz monitor de PRESSÃO e
# "notebook" traz caderno de papel — por isso algumas viraram frase.
CAPTURE_KEYWORDS=notebook,monitor gamer,monitor led,teclado,mouse gamer,headset gamer,fone de ouvido,ssd,memoria ram,placa de video,processador,webcam,roteador,cadeira gamer,celular,carregador,power bank,cabo usb,smartwatch,tablet,caixa de som,pendrive,cartao de memoria,impressora,geladeira,fogao,microondas,liquidificador,batedeira,cafeteira,air fryer,aspirador de po,ventilador,panela,ferro de passar,chaleira eletrica,purificador de agua,robo aspirador,maionese,ketchup,mostarda,azeite,cafe,achocolatado,chocolate,macarrao,tempero,oleo de cozinha,leite condensado
CAPTURE_SORT_TYPE=2                 # 2 = mais vendidos
CAPTURE_LIMIT=12                    # ofertas que a Shopee devolve por keyword
CAPTURE_KEYWORDS_PER_CYCLE=16       # rotação: 16 de 48 por ciclo (cobre tudo em ~1h30)
CAPTURE_TOP_PER_KEYWORD=1           # quantas sobrevivem por keyword depois do ranking
CAPTURE_MAX_PER_CYCLE=10            # teto global do ciclo
CAPTURE_MIN_SALES=20                # prova social mínima
CAPTURE_MIN_RATING=4
CAPTURE_MIN_COMMISSION_BRL=0.5      # ganho mínimo por venda (filtro de qualidade real)
CAPTURE_MIN_COMMISSION=0            # decimal (0.05 = 5%); 0 = sem mínimo
CAPTURE_CRON=*/30 * * * *           # roda a captura a cada 30 min
CAPTURE_BACKLOG_MAX=30              # fila cheia = pula o ciclo

# Validade da oferta na fila, em horas. NÃO desligue sem entender o efeito:
# além de o preço envelhecer (postar preço de 3 dias atrás é postar mentira),
# é isto que impede o IMPASSE — sem canal conectado nada esvazia a fila, a fila
# fica acima de CAPTURE_BACKLOG_MAX para sempre e a captura nunca mais roda.
# Já aconteceu em produção: 7 dias parado, 336 ciclos pulados, /health em 200.
OFFER_MAX_AGE_HOURS=48

# ---- Inteligência de mercado (engenharia reversa do critério dos concorrentes) ----
# A captura acima é ESTREITA (escolhe 10 para postar). A varredura abaixo é o
# oposto: passa por TODAS as keywords, não filtra nada, e só registra o cardápio
# que a Shopee ofereceu. É contra esse cardápio que os posts dos grupos são
# cruzados — sem ele, não existe correlação, só uma comparação com as suas
# próprias escolhas (que responde uma pergunta bem mais fraca).
INTEL_ENABLED=true
INTEL_SWEEP_CRON=7 */2 * * *        # a cada 2h, no minuto 7 (não colide com a captura)
INTEL_SWEEP_LIMIT=20                # ofertas por keyword na varredura
INTEL_RETENTION_DAYS=90             # poda; 0 desliga (a tabela cresce ~11 mil linhas/dia)
# Similaridade mínima de título para o veredito "casado". 0.30 saiu de medição
# com títulos reais (o mesmo produto reescrito pelo grupo ficou em 0.328; uma
# marca diferente da mesma categoria ficou em 0.196). CALIBRE depois da primeira
# semana: o painel mostra os "quase acertou" e o botão "recorrelacionar"
# reprocessa tudo com o limiar novo.
INTEL_MATCH_MIN_SIM=0.30
INTEL_MATCH_PRICE_TOLERANCE=0.15    # 15% de diferença de preço tolerada
INTEL_MATCH_WINDOW_HOURS=72         # procura observações até 72h antes do post
INTEL_MATCH_AMBIGUITY_MARGIN=0.06   # empate técnico -> veredito 'ambiguo'

# Orçamento de chamadas: captura ~768/dia + varredura ~576/dia = ~1.344/dia,
# contra o teto de 2.500/dia do freio da Shopee (SHOPEE_MAX_PER_DAY). Se você
# aumentar keywords ou reduzir o INTEL_SWEEP_CRON, refaça essa conta.

# ============================================================
# SETUP: infra no .env (DATABASE_URL, REDIS_URL, SHOPEE_APP_*, API_DOMAIN,
# POSTGRES_PASSWORD). Evolution (URL+key) e OpenAI podem ir na aba Config do
# painel em vez do .env. Conectar número e cadastrar grupo: aba Conexões.
# Grupos observados e o endereço de entrada do n8n: aba Grupos observados.
# ============================================================
